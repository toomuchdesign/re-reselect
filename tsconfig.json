{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "lib": ["es6"],
    "skipLibCheck": true,
    "noEmit": true
  },
  // Every hand-written TS file in the repo: library sources, test suites and
  // the root-level tooling configs. `tsconfig.build.json` narrows this down to
  // `src` for the bundler.
  "include": ["."],
  "exclude": ["dist", "coverage"]
}
